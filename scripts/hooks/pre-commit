#!/bin/sh
# Never bypass with --no-verify. See AGENTS.md.
set -e
cd "$(git rev-parse --show-toplevel)"
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
if [ -f "$HOME/.config/life-os/denylist.txt" ]; then
  python3 scripts/privacy_scan.py --staged
else
  echo "pre-commit: deny list missing (~/.config/life-os/denylist.txt), refusing" >&2
  exit 1
fi
